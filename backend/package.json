{
  "name": "@care-record/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node ../scripts/build-backend.mjs",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:import": "tsx ../scripts/import-sqlite.ts",
    "db:backup": "tsx ../scripts/postgres-backup.ts backup",
    "db:check": "tsx ../scripts/check-database.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "pg": "8.23.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
